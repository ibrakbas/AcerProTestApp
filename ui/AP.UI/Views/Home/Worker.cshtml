@{
    ViewData["Title"] = "Çalışanlar";
}


<h1>@ViewData["Title"]</h1> 
<div class="row"> 
    <div class="col-sm-12">
        <div class="card">

            <div class="card-body">
                <div class="form-group"> 
                    <a asp-action="CreateWorker" class="btn btn-success">Yeni Çalışan</a>
                </div>
                <div class="dt-responsive table-responsive">
                    <table id="dom-table" class="table table-striped table-bordered nowrap">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Adı</th>
                                <th>Soyadı</th>
                                <th>Departman</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var worker in ViewBag.Workers)
                            {
                                <tr>
                                    <td>@worker.Id</td>
                                    <td>@worker.Name</td>
                                    <td>@worker.Surname</td>
                                    <td>@worker.Department.Description</td>
                                    <td>
                                        <a asp-action="UpdateWorker" class="btn btn-primary">Düzenle</a>
                                        <a asp-action="DeleteWorker" class="btn btn-danger">Kaldır</a>
                                         
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div> 
</div>