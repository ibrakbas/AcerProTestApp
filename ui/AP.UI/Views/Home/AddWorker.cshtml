<center>

    <div class="col-sm-6"> 
        <div class="card">
            <div class="card-header">
                <h5>Çalışan Bilgileri</h5>
            </div>
            <div class="card-body">

            </div>
            <div class="form-group">
                <label class="form-label">Adı</label>
                <input type="text" class="form-control form-control" placeholder="Çalışan Adı">
            </div>
            <div class="form-group">
                <label class="form-label">Soyadı</label>
                <input type="text" class="form-control form-control" placeholder="Çalışan Soyadı">
            </div>
            <div class="form-group">
                <label class="form-label" for="exampleSelect1">Departman</label>
                <select class="form-select" id="exampleSelect1"> 
                    @foreach (var Department in ViewBag.Departments)
                    {
                        <option>Department.Definition</option> 
                    }
                </select>
            </div>
             
        </div>
        <div class="card-footer">
            <button class="btn btn-primary me-2">Kaydet</button> 
        </div>
    </div>
</div>
</center>